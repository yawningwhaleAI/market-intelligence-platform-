# Supabase project URL and public anon key. Never use the service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SCOUTWISE_SITE_URL=http://127.0.0.1:8000

# Generate 32 random bytes and URL-safe-base64 encode them. Keep separate from Apify.
SCOUTWISE_CREDENTIAL_ENCRYPTION_KEY=

# Optional AI providers. Keys stay server-side. Models can be changed without code edits.
AI_PROVIDER_ORDER=openrouter,gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional guardrail override.
SCOUTWISE_DEFAULT_RUN_CAP_USD=5
